{
  "name": "testmanager-local-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright Local Runner for TestManager — pulls automation jobs from the central server, runs Playwright locally, and reports results back.",
  "type": "module",
  "bin": {
    "tm-runner": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}

# --- Central server (self-hosted TestManager / Supabase) ---
# Base URL of the Supabase project the app uses (same as VITE_SUPABASE_URL).
TM_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon key. The automation RPCs are granted to anon; the runner token
# below is what actually authorizes this runner. Same value as VITE_SUPABASE_ANON_KEY.
TM_SUPABASE_ANON_KEY=your-anon-key

# --- Runner identity ---
# The one-time token shown in the app when the runner was created (Automation > Runner Baru).
TM_RUNNER_TOKEN=tm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Playwright project under test ---
# Directory that contains the Playwright project (playwright.config.*, tests/...).
# script_ref values from the server are resolved relative to this directory.
TM_PROJECT_DIR=/absolute/path/to/playwright-project
# Command used to invoke Playwright. Override if you use a custom runner/wrapper.
TM_PLAYWRIGHT_CMD=npx playwright test

# --- Polling behaviour ---
# Seconds between polls when the queue is empty.
TM_POLL_INTERVAL_SECONDS=5
# Seconds between heartbeats so the UI can show online/offline.
TM_HEARTBEAT_INTERVAL_SECONDS=30
# Hard timeout (seconds) for a single job's Playwright run.
TM_JOB_TIMEOUT_SECONDS=900

# --- Artifacts ---
# Where Playwright artifacts (screenshot/video/trace/log) are collected locally.
TM_ARTIFACT_DIR=./artifacts
# Upload artifacts to Supabase Storage via the automation-artifacts Edge Function
# (signed upload URLs; the runner never holds the service key). Default: true.
# Set to false to skip uploading and only report local/base-url references.
TM_ARTIFACT_UPLOAD=true
# Fallback only (when TM_ARTIFACT_UPLOAD=false): if set, reported artifact URLs
# become `${TM_ARTIFACT_BASE_URL}/<jobId>/<file>`; otherwise a local file:// path.
TM_ARTIFACT_BASE_URL=

TM_SUPABASE_URL=https://your-project.supabase.co
TM_SUPABASE_ANON_KEY=your-supabase-anon-key
TM_API_TOKEN=your-testmanager-api-token
TM_PROJECT_ID=your-project-id
TM_MCP_READONLY=1
# Batas pemanggilan per tool dan API token dalam satu window (default 120 per 60 detik).
TM_MCP_RATE_LIMIT=120
TM_MCP_RATE_LIMIT_WINDOW_SECONDS=60
# Batas test regression selektif sebelum wajib konfirmasi manusia (default 25).
TM_MCP_RERUN_FAILED_MAX_TESTS=25
TM_MCP_REPOSITORY_CACHE_DIR=/tmp/testmanager-mcp-repositories
# JWT user Supabase approved; hanya diperlukan oleh issue.detect_duplicate.
TM_SUPABASE_ACCESS_TOKEN=
